# ============================================================
# Canton Telegram Bot - 환경변수 설정
# 이 파일을 .env로 복사한 후 값을 채워주세요
# cp .env.example .env
# ============================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_id

# --- Twitter/X (twscrape 인증) ---
# 방법 1: 계정 로그인 (기본)
TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password
TWITTER_EMAIL=your_email@example.com
TWITTER_EMAIL_PASSWORD=your_email_password

# 방법 2: 쿠키 기반 인증 (더 안정적, 선택사항)
# 브라우저에서 Twitter 로그인 후 쿠키를 복사해서 입력
TWITTER_COOKIES=

# --- CoinGecko (선택사항) ---
# https://www.coingecko.com/en/api 에서 무료 Demo API Key 발급
COINGECKO_API_KEY=

# --- 스케줄 ---
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
TIMEZONE=Asia/Seoul
