# ============================================================
# Canton Telegram Bot - 환경변수 설정
# 이 파일을 .env로 복사한 후 값을 채워주세요
# cp .env.example .env
# ============================================================

# --- Telegram (필수) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_id

# --- Twitter/X (필수) ---
# RapidAPI Twitter API45 키
# https://rapidapi.com/DataFanatic/api/twitter-api45 에서 발급
RAPIDAPI_KEY=your_rapidapi_key_here

# --- CoinGecko (선택) ---
# https://www.coingecko.com/en/api 에서 무료 Demo API Key 발급
# 없어도 동작하지만 레이트 리밋에 걸릴 수 있음
COINGECKO_API_KEY=

# --- 스케줄 ---
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
TIMEZONE=Asia/Seoul
