# ============================================================
# Canton Hub — Backend environment variables
# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
# NEVER commit the real `.env`.
# ============================================================

# --- CoinGecko (strongly recommended) ---
# Demo API key, free at https://www.coingecko.com/en/developers/dashboard
# Without this you'll hit 429s in production — the free IP pool is aggressive.
COINGECKO_API_KEY=

# --- RapidAPI — Twitter API45 (required for /api/feed) ---
# https://rapidapi.com/DataFanatic/api/twitter-api45
RAPIDAPI_KEY=

# --- GitHub PAT (required for /api/governance CIPs) ---
# https://github.com/settings/tokens — read-only public_repo scope is enough
GITHUB_TOKEN=

# NOTE: AI 요약(news/tweet)·다국어 번역은 헤드리스 `claude -p`(Mac Max 구독)로
# 동작하므로 ANTHROPIC_API_KEY / DEEPL_API_KEY 가 필요 없다. (claude CLI 로그인 필요)

# --- CORS tightening (production only) ---
# Leave UNSET in local dev (defaults to "*").
# In production, set to the deployed frontend URL(s), comma-separated.
# Example: ALLOWED_ORIGINS=https://canton-hub.vercel.app
ALLOWED_ORIGINS=

# --- Finnhub (recommended, DAT tracker live stock price → mNAV) ---
# Free key, 60 req/min. Get it in ~30s at https://finnhub.io/register (no card).
# This is the PRIMARY stock-price source. Keyless Yahoo/stooq 429 the backend IP on
# burst cycles, blanking mNAV/risk. With a key, single-ticker 5-min polling is stable.
# Without it, the collector falls back to Yahoo (429-prone) → mNAV may show "—".
FINNHUB_API_KEY=

# --- stooq apikey (optional, last-resort DAT price fallback) ---
# Free: open https://stooq.com/q/d/?s=cntn.us&get_apikey , solve captcha, copy the key.
# NOTE: stooq currently returns a JS-challenge page instead of CSV (effectively dead).
# Prefer FINNHUB_API_KEY above. Current price/mNAV work via Finnhub without this.
STOOQ_APIKEY=

# --- Timezone (used for log timestamps) ---
TIMEZONE=Asia/Seoul
