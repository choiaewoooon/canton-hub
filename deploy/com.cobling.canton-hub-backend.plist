<?xml version="1.0" encoding="UTF-8"?>
<!--
  Canton Hub 백엔드 LaunchAgent

  홈 Mac에서 uvicorn(FastAPI + APScheduler)을 상시 실행한다.
  Fly.io 대체 경로 — Cloudflare가 datacenter IP를 차단하는 CantonScan 접근을
  홈 Mac의 가정용 ISP IP로 우회하기 위함.

  설치:
    cp deploy/com.cobling.canton-hub-backend.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.cobling.canton-hub-backend.plist

  로그:
    /tmp/canton-hub-backend.out.log
    /tmp/canton-hub-backend.err.log

  환경변수는 canton-hub/.env 에서 python-dotenv가 자동 로드한다.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cobling.canton-hub-backend</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/choejaewon/project/Ozzycanton/canton-hub/venv/bin/python</string>
        <string>-m</string>
        <string>uvicorn</string>
        <string>api.main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8000</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/choejaewon/project/Ozzycanton/canton-hub</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>

        <!--
          uvloop은 DNS(getaddrinfo)를 libuv 스레드풀에 넘기는데 기본 크기가 4다.
          느리거나 막힌 호스트 하나가 4개를 다 잡으면 프로세스 안의 모든 DNS가
          그 뒤에 굶는다 (2026-07-29 전체 마비 사고 — collectors/net_guard.py 참조).
          OS getaddrinfo는 취소가 불가능해 httpx 타임아웃으로도 스레드를 되찾지 못한다.
          net_guard가 1차 방어, 이 여유분이 2차 방어다.
        -->
        <key>UV_THREADPOOL_SIZE</key>
        <string>64</string>
    </dict>

    <!-- Mac 부팅 시 자동 실행 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 크래시 시 자동 재시작 -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <!-- 재시작 간 10초 쿨다운 (crash loop 방지) -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/canton-hub-backend.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/canton-hub-backend.err.log</string>
</dict>
</plist>
