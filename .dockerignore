# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
.venv/
*.egg-info/

# Git & IDE
.git/
.gitignore
.vscode/
.idea/
.claude/

# Env & secrets (NEVER bake into image)
.env
.env.local
.env.*.local

# Logs
*.log

# Tests & docs
tests/
docs/
*.md
README*

# Frontend — never needs to be in the backend image
web/

# Local file caches — collectors will rebuild these fresh on boot
data/*.json
data/*.html

# OS junk
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
